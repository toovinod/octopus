# Cloud API (apps/api). Copy to .env and fill in. Never commit real values.
# Agent credentials (Anthropic or OpenAI keys, OAuth tokens) never go here: an Octopus login authenticates Octopus only.

# Port the API listens on. Defaults to 3001.
API_PORT=3001

# How long the API waits for requests in flight when it stops. Defaults to "10 seconds".
# Keep it a few seconds below the host's stop timeout, so requests finish before the host sends SIGKILL.
API_SHUTDOWN_GRACE=

# Public URL of the API, where Better Auth is mounted at /api/auth.
BETTER_AUTH_URL=http://localhost:3001

# Random secret of at least 32 characters, for example from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Rate limits count requests per client address.
# Leave empty when clients reach the API directly: the address is then the socket's, and X-Forwarded-For is ignored.
# Behind a load balancer or CDN, list the address ranges its requests come from, comma separated, in CIDR notation
# (for example "10.0.0.0/8", or Cloudflare's published ranges). X-Forwarded-For is then read from the right,
# skipping those proxies, and is ignored on requests that do not come from one, so a client cannot fake its address.
API_TRUSTED_PROXIES=

# Origin of the static web app (sign-in, device approval, invite accept). The only CORS origin allowed.
# It must be on the same site as BETTER_AUTH_URL, such as https://app.example.com and https://api.example.com,
# because session cookies are SameSite=Lax. Ports do not matter, so the localhost defaults work.
WEB_ORIGIN=http://localhost:3000

# Postgres connection string. This default matches docker-compose.yml (`bun run db:up`).
# For Neon, use its connection string with sslmode=require.
# Deploys run `bun run --cwd packages/db-cloud db:migrate:deploy` before starting the API. It reads only the host's environment,
# and instances that start together wait on a database lock, so each migration runs once.
DATABASE_URL=postgres://octopus:octopus@localhost:5432/octopus

# Redis for BullMQ. This default matches docker-compose.yml.
REDIS_URL=redis://localhost:6379

# GitHub OAuth app. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, for org invitation emails.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, for example "Octopus <invites@example.com>".
EMAIL_FROM=
